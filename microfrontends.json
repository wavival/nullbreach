{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "version": "1",
  "applications": {
    "wavival-dev": {
      "development": {
        "fallback": "wavival-dev.vercel.app",
        "local": 4321
      }
    },
    "nullbreach": {
      "routing": [
        {
          "group": "nullbreach",
          "paths": ["/nullbreach/:path*"]
        }
      ],
      "development": {
        "fallback": "null-breach.vercel.app",
        "local": 3000
      }
    }
  }
}
