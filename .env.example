# Prisma Postgres connection string used by Prisma ORM. Keep this value secret.
# Vercel production resource: prisma-postgres-amber-crystal.
# Vercel staging resource: nullbreach-stg-postgres.
# Never connect either resource to the other environment.
DATABASE_URL=""

# Random secret used to sign NextAuth sessions. Keep this value secret.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Full NextAuth endpoint URL. This is normal configuration, not a secret.
# Local: http://localhost:3000/nullbreach/api/auth
# Production: https://wavival.dev/nullbreach/api/auth
# Preview (stg): https://nullbreach-git-stg-wavivals-projects.vercel.app/nullbreach/api/auth
NEXTAUTH_URL="http://localhost:3000/nullbreach/api/auth"

# Google OAuth credentials. Create a Web application in Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Brevo credentials used to send password-reset emails.
BREVO_API_KEY=""
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="NullBreach"

# Server-side OpenAI API key. Keep this value secret and never prefix it with NEXT_PUBLIC_.
# Create one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=""

# OpenAI model identifier. This is normal configuration, not a secret.
OPENAI_MODEL="gpt-5"
